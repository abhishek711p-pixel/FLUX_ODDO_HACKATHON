# Copy this file to .env and fill in your own values
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/subflow
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional: email for password reset and invoices.
# If left empty, reset links are printed in the server log and shown on screen (demo mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Brightloop Billing <billing@brightloop.in>"

# Automatic billing runs at start-up and every hour (set to false to only bill manually)
AUTO_BILLING=true
