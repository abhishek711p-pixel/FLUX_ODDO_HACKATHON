# Copy this file to .env and fill in your own values
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/subflow
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional: your business name and billing email, printed on invoices and emails (leave empty to stay generic)
COMPANY_NAME=
COMPANY_EMAIL=

# Optional: email for password reset and invoices.
# If left empty, reset links are printed in the server log and shown on screen (demo mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SubFlow Billing <billing@yourcompany.com>"

# Automatic billing runs at start-up and every hour (set to false to only bill manually)
AUTO_BILLING=true
